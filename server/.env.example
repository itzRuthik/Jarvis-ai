# =============================================================================
# JARVIS AI — server proxy configuration
# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored. NEVER commit real keys.
# =============================================================================

# ---- server ----
PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated list of browser origins allowed to call this proxy.
# GitHub Pages + local development are shown as examples.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8787,https://itzruthik.github.io

# Optional shared secret. When set, the browser must send
#   Authorization: Bearer <PROXY_TOKEN>
# in addition to its own request. Leave empty to disable.
PROXY_TOKEN=

# ---- upstream provider ----
# openai | gemini | anthropic
AI_PROVIDER=openai

# OpenAI-compatible (OpenAI, Groq, OpenRouter, your own gateway)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ---- limits & safety ----
# Requests allowed per IP per minute (protects your wallet).
RATE_LIMIT_PER_MIN=30
# Hard cap on completion tokens regardless of what the client asks for.
MAX_OUTPUT_TOKENS=1200
# Reject prompts longer than this many characters.
MAX_PROMPT_CHARS=24000
# Set to 1 to enable Google Safe Browsing checks on URLs found in prompts.
SAFETY_CHECKS=0
GOOGLE_SAFETY_KEY=
