{
  "name": "jarvis-ai",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "JARVIS AI \u2014 a futuristic personal AI assistant with a holographic HUD, voice, search, memory and an offline core. Web app + PWA + Android APK.",
  "keywords": [
    "ai-assistant",
    "pwa",
    "android",
    "capacitor",
    "voice-assistant",
    "holographic-ui",
    "offline-first"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node tools/serve.mjs",
    "dev": "node tools/serve.mjs",
    "test": "node tools/test.mjs",
    "verify": "node tools/verify-shell.mjs",
    "smoke": "node tools/smoke-dom.mjs",
    "check": "node tools/verify-shell.mjs && node tools/test.mjs && node tools/smoke-dom.mjs",
    "android:sync": "cd capacitor && npm run sync",
    "android:build": "cd capacitor && npm run build:debug"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itzRuthik/Jarvis-ai.git"
  },
  "devDependencies": {
    "jsdom": "^30.1.2"
  }
}
